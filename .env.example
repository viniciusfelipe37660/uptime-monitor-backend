# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (use Neon, Render, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/uptime_monitor?schema=public"

# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="15m"

# Must match the exact origin of the deployed frontend (no wildcards)
CORS_ORIGIN="http://localhost:3001"
